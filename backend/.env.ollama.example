# Configuración del backend - JP Flashcards

# --- Configuración de zAI GLM (retrocompatibilidad) ---
# Obtén tu API Key gratuita en: https://open.bigmodel.cn/
ZAI_API_KEY=tu-clave-de-zai-aqui
ZAI_MODEL=glm-4-flash

# --- Configuración de Ollama Local (nuevo) ---
# Descomenta y configura si usas Ollama local
OLLAMA_HOST=http://cos-alicante.netbird.vpn
OLLAMA_MODEL=llama3.1
# OLLAMA_MODEL=gemma2:9b  # Alternativa más rápida
# OLLAMA_MODEL=mistral:nemo:latest  # Alternativa generalista

# --- Configuración del servidor ---
PORT=3000
HOST=rpi4.netbird.vpn

# --- Seguridad (obligatorio) ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- Servicio OCR (vocabulario y lecciones) ---
OCR_BASE_URL=https://ocr.reigreengroup.com
OCR_API_KEY=tu-clave-del-servicio-ocr
# No inventes doc_types: el servicio aplicaría su prompt de facturas.
OCR_LESSON_DOC_TYPE=scan
OCR_VOCAB_DOC_TYPE=table
