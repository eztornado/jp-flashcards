# Configuración de llama.cpp (servidor OpenAI-compatible)
# Tiene prioridad sobre Ollama si está configurado
LLAMACPP_HOST=http://cos-alicante.netbird.vpn:8080
LLAMACPP_MODEL=gemma4:12b

# Configuración de Ollama (opcional)
OLLAMA_HOST=
OLLAMA_MODEL=

# Configuración de zAI GLM
# Obtén tu API key gratis en: https://open.bigmodel.cn/
ZAI_API_KEY=your-zai-api-key-here

# Opcional: Modelo a usar (por defecto: glm-4-flash)
# Modelos disponibles:
# - glm-4-flash (Gratis, rápido, ideal para chat)
# - glm-4-plus (De pago, más potente)
# - glm-4-vision (De pago, con visión)
ZAI_MODEL=glm-4-flash

# Configuración del microservicio OCR de Reigreengroup
# Requerido para: importación de vocabulario por OCR y generación de lecciones
OCR_BASE_URL=https://ocr.reigreengroup.com
OCR_API_KEY=tu-clave-del-servicio-ocr

# Tipo de documento enviado al OCR (opcional)
# Valores válidos: general, contrato, table, handwriting, scan, auto_detect, company_*...
# IMPORTANTE: no uses valores inventados ("leccion_japones", "vocabulario_japones"):
# el servicio los trata con su prompt de facturas y devuelve datos sin sentido.
# - Lecciones: "scan" (texto libre) o "table" (conserva tablas)
# - Vocabulario: "table"
OCR_LESSON_DOC_TYPE=scan
OCR_VOCAB_DOC_TYPE=table

# Seguridad (obligatorio)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
