# ===== Configuración del proyecto (copiar a .env en la raíz para Docker Compose) =====
# Para desarrollo local, el backend usa backend/.env (ver backend/.env.example).

# Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Seguridad (OBLIGATORIO)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# IA (prioridad: llama.cpp > Ollama > zAI)
# OLLAMA_HOST=http://ollama:11434
# OLLAMA_MODEL=llama3.1
# LLAMACPP_HOST=http://cos-alicante.netbird.vpn:8080
# LLAMACPP_MODEL=gemma4:12b
# ZAI_API_KEY=tu_api_key_aqui
# ZAI_MODEL=glm-4-flash

# OCR (necesario para importar vocabulario y generar lecciones)
OCR_BASE_URL=https://ocr.reigreengroup.com
OCR_API_KEY=tu-clave-del-servicio-ocr
# No inventes doc_types: el servicio aplicaría su prompt de facturas.
OCR_LESSON_DOC_TYPE=scan
OCR_VOCAB_DOC_TYPE=table
